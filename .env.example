# Hosted chat uses each visitor's own key from My Coach > Bring your own API key.
# No operator API key is needed. The public route ignores AI_API_KEY and OPENAI_API_KEY.
# Never put a private key in NEXT_PUBLIC_* variables.

# Optional: pin ONE extra provider endpoint alongside the four built-in providers.
# Choose openai-compatible (base URL) or custom (full adapter URL).
# Leave both blank to offer only Gemini, OpenAI, Anthropic, and Grok.
AI_PROVIDER=
AI_BASE_URL=

# Visitors enter their API key and optional model in the app.
# Compatible providers require a model ID. Restart Next.js after endpoint changes.
# Use only a trusted endpoint: it will receive visitors' credentials and chat text.
